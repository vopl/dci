
targetDir ..
stateDir ../var/aup
;importDir ../var/aups4Import

target
{
    srcBranch            master
    srcRevision          *
    platformOs           same
    platformArch         same
    compiler             same
    compilerVersion      *
    compilerOptimization same
    stability            0
    vendor               same
    vendorSign           ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    unit                 *
    fileKind             minimal
}

buffer
{
    srcBranch **
    srcRevision *
    platformOs *
    platformArch *
    compiler *
    compilerVersion *
    compilerOptimization *
    stability *
    vendor *
    vendorSign *
    unit *
    fileKind *
}
