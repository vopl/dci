require "id.idl"
require "ppn/transport/channel/state.idl"

scope ppn::node::link
{
    scope remote
    {
        interface Payload
        {
            in ids() -> set<ilid>;
            out idsChanged();

            in getInstance(ilid) -> interface;
        }
    }

    interface Remote : transport::channel::State, remote::Payload
    {
        in id() -> Id;
    }
}
