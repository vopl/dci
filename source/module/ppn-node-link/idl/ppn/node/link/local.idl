require "error.idl"
require "id.idl"
require "remote.idl"
require "feature.idl"
require "ppn/transport/channel.idl"

scope ppn::node::link
{
    interface Local
    {
        in setFeatures(list<Feature> features);
        in setKey(Key);
        in id() -> Id;

        in joinByConnect(transport::Channel) -> Remote;
        in joinByAccept(transport::Channel) -> Remote;
    }
}
