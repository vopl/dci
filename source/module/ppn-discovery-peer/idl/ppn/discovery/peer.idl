require "configurable.idl"
require "ppn/node/link/feature.idl"
require "ppn/node/feature.idl"

scope ppn::discovery
{
    interface Peer
        : node::link::Feature
        , node::link::feature::Payload
        , node::Feature
        , Configurable
    {
    }

    scope peer
    {
        exception Error {}

        interface Supplier
        {
            in get() -> list<transport::Address>;
            out put(transport::Address);
        }
    }
}
