require "configurable.idl"
require "ppn/transport/address.idl"

scope ppn::transport
{
    scope natt
    {
        enum Protocol
        {
            udp,
            tcp,
        }

        interface Mapping
        {
            in start(Address internal, Protocol);
            in stop();

            out established(Address exernal);
            out unestablished();
        }
    }

    interface Natt : Configurable
    {
        in mapping() -> natt::Mapping;
    }
}
