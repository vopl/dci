require "error.idl"
require "endpoint.idl"
require "channel.idl"

scope ppn::transport
{
    scope connector
    {
        interface Doer
        {
            in connect(Address) -> Channel;
        }

        interface Downstream
            : Doer
            , Endpoint
        {
        }

        exception Error : transport::Error{}
        exception ConnectionRefused : Error{}
    }

    interface Connector
        : connector::Doer
    {
        in add(connector::Downstream);
        in del(connector::Downstream);
    }
}
