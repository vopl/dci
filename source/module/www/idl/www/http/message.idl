require "header.idl"
require "firstLine.idl"

scope www::http
{
    interface Message
    {
        in headers(list<Header>, bool done);
        in data(bytes, bool done);
        in done();
    }

    scope message
    {
        scope tunable
        {
            enum Compression
            {
                none,
                byHeaders,
                deflate,
                gzip,
                br,
                zstd,
            }

            enum Encoding
            {
                none,
                byHeaders,
                chunked,
            }
        }

        interface Tunable
        {
            in setupDataProcessing(
                tunable::Compression contentCompression,
                tunable::Compression transferCompression,
                tunable::Encoding transferEncoding);
        }

        interface C2S : Message
        {
            in firstLine(firstLine::Method, string uri, firstLine::Version);
        }

        interface S2C : Message
        {
            in firstLine(firstLine::Version, firstLine::StatusCode, string statusText);
        }
    }
}
