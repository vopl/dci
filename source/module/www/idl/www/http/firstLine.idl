scope www::http::firstLine
{
    enum Method
    {
        null,
        OPTIONS,
        GET,
        HEAD,
        POST,
        PUT,
        PATCH,
        DELETE,
        TRACE,
        CONNECT,
    }

    alias StatusCode = uint16;

    enum Version
    {
        null,
        HTTP_0_9,
        HTTP_1_0,
        HTTP_1_1,
    }
}
