require "link.idl"

scope net::route
{
    struct Entry4
    {
        Ip4Address  dst;
        uint8       dstPrefixLength;

        Ip4Address  nextHop;

        uint32      linkId;
    }

    struct Entry6
    {
        Ip6Address  dst;
        uint8       dstPrefixLength;

        Ip6Address  nextHop;

        uint32      linkId;
    }
}
