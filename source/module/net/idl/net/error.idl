scope net
{
    exception Error {}
    exception ConnectionClosed : Error {}
    exception ResolveError : Error {}

    exception AddressInIse              : Error {}
    exception AddressNotAvailable       : Error {}
    exception AlreadyConnected          : Error {}
    exception BadAddress                : Error {}
    exception ConnectionAborted         : Error {}
    exception ConnectionRefused         : Error {}
    exception ConnectionReset           : Error {}
    exception HostUnreachable           : Error {}
    exception InvalidArgument           : Error {}
    exception NetworkDown               : Error {}
    exception NetworkReset              : Error {}
    exception NetworkUnreachable        : Error {}
    exception NotConnected              : Error {}
    exception OperationCanceled         : Error {}
    exception OperationInProgress       : Error {}
    exception OperationNotSupported     : Error {}
    exception PermissionDenied          : Error {}
    exception UnavaliableTryAgain       : Error {}
    exception TimedOut                  : Error {}
}
